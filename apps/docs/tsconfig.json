{
	"extends": "@ollin/console-infra/tsconfig/base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@docs/*": ["src/*"],
			"@docs-components/*": ["vitepress/theme/components/*"],
			"@docs-config": ["vitepress/config.ts"],
			"@docs-lib/*": ["vitepress/theme/lib/*"],
			"@docs-tests/*": ["tests/*"],
			"@docs-theme/*": ["vitepress/theme/*"],
			"@docs-ui/*": ["vitepress/theme/components/ui/*"],
			"@ollin/console": ["../../pkgs-ts/console/src/index.ts"],
			"#console/*": ["../../pkgs-ts/console/src/*"],
			"#console/prompts/*": ["../../pkgs-ts/console/src/prompts/*"]
		},
		"tsBuildInfoFile": "../../infra/.cache/tsbuild/docs.tsbuildinfo"
	},
	"include": ["examples/**/*.ts", "tests/**/*.ts", "vitepress/**/*.ts", "vitest.config.ts", "../../pkgs-ts/console/src/**/*.ts"]
}
