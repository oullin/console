{
	"extends": "@ollin/console-infra/tsconfig/base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@docs-components/*": ["theme/components/*"],
			"@docs-lib/*": ["theme/lib/*"],
			"@docs-theme/*": ["theme/*"],
			"@docs-ui/*": ["theme/components/ui/*"]
