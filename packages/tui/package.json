{
  "name": "@ollin/tui",
  "version": "0.1.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#tui/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "#tui/prompts/*": {
      "types": "./dist/prompts/*.d.ts",
      "default": "./dist/prompts/*.js"
    }
  },
  "scripts": {
    "build": "XDG_CACHE_HOME=../../provision/.cache/xdg PLAYWRIGHT_BROWSERS_PATH=../../provision/.cache/playwright tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "XDG_CACHE_HOME=../../provision/.cache/xdg PLAYWRIGHT_BROWSERS_PATH=../../provision/.cache/playwright vitest run --config vitest.config.ts",
    "typecheck": "XDG_CACHE_HOME=../../provision/.cache/xdg PLAYWRIGHT_BROWSERS_PATH=../../provision/.cache/playwright tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.4.0",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ollin/artefacts": "workspace:*",
    "@ollin/tsconfig": "workspace:*",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
