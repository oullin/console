{
	"name": "docs",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"api": "typedoc --options typedoc.json && cp src/api/README.md src/api/index.md",
		"build": "pnpm api && vitepress build src",
		"dev": "pnpm api && vitepress dev src --host 127.0.0.1",
		"preview": "vitepress preview src --host 127.0.0.1",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@ollin/tui": "workspace:*",
		"@vueuse/core": "^14.3.0",
		"@xterm/xterm": "^6.0.0",
		"reka-ui": "^2.9.10"
	},
	"devDependencies": {
		"@ollin/tsconfig": "workspace:*",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^25.6.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.5",
		"vue": "^3.5.38"
	}
}
