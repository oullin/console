{
	"name": "docs",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"api": "typedoc --options typedoc.json && cp src/api/README.md src/api/index.md",
		"build": "pnpm api && vitepress build src",
		"dev": "pnpm api && vitepress dev src --host 127.0.0.1",
		"preview": "vitepress preview src --host 127.0.0.1",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@ollin/tui": "workspace:*",
		"@xterm/xterm": "^6.0.0"
	},
	"devDependencies": {
		"@ollin/tsconfig": "workspace:*",
		"@types/node": "^25.6.2",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.12.0",
		"typescript": "^6.0.3",
		"vitepress": "^1.6.4",
		"vitest": "^4.1.5"
	}
}
