*.tsbuildinfo
**/dist/
**/.vitepress/cache/
**/.vitepress/dist/
apps/docs/src/.vitepress/
apps/docs/src/api/

# OS / editor
.DS_Store
.idea/

# Go
pkgs-go/bin/
*.test
*.out
